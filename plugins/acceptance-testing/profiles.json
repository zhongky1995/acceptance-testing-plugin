{
  "schema_version": "1.0",
  "scenarios": {
    "local-iteration": {
      "principle": "复用当前环境，围绕改动和业务风险选测。",
      "default_install": false,
      "first": ["已有测试与变更影响", "构建或相关静态检查", "关键业务冒烟"],
      "expand_when": ["权限、数据结构、依赖或运行配置改变", "改动影响范围不明", "发现阻断或覆盖缺口"],
      "not_automatic": ["冷安装", "完整压测", "备份恢复演练", "第二客户部署"]
    },
    "third-party": {
      "principle": "先只读预检，再为当前验证补齐必要条件。",
      "default_install": false,
      "first": ["来源与交付材料", "依赖声明与启动脚本", "配置要求", "已有测试和运行证据"],
      "expand_when": ["实际运行缺少必要依赖", "运行方法不明", "交付证据不足"],
      "not_automatic": ["安装全部可选组件", "创建云服务", "付费真实集成"]
    },
    "target-delivery": {
      "principle": "依据目标环境和交付承诺取得实测证据。",
      "default_install": false,
      "first": ["目标环境与资源约束", "约定业务门禁", "安装和配置可迁移性"],
      "expand_when": ["独立安装承诺", "多环境或多客户复制", "升级/恢复承诺", "规模与成本约束"],
      "not_automatic": ["所有系统版本穷举", "生产变更", "无目标的压力测试"]
    }
  },
  "project_types": {
    "local-tool": ["文件输入输出", "环境兼容", "迁移与卸载"],
    "web": ["浏览器流程", "角色权限", "数据持久化"],
    "saas": ["租户隔离", "客户开通", "容量", "单位客户成本"],
    "private-deployment": ["内网/代理", "离线依赖", "硬件", "升级/恢复", "第二次交付"],
    "ai-agent": ["固定评测样本", "模型/工具能力", "中断恢复", "失败重试", "成功任务成本"],
    "desktop-extension": ["宿主版本", "安装更新", "权限", "后台资源"]
  },
  "stages": {
    "prototype": "证明指定范围可演示，保留限制，不宣称正式交付。",
    "pilot": "关键用户任务、权限与数据规则通过，说明剩余问题。",
    "release": "约定回归、环境与专项检查完成，阻断项与负责人验收明确。"
  },
  "budget_guidance": {
    "template_execution_seconds": 600,
    "template_attempts": 2,
    "template_external_cost": 0,
    "note": "数值是可调整起点，不是对所有项目强制的成本承诺；外部费用未知时不自动调用。"
  }
}
